-- Yellow Markets - Order Resolution Dedicated Tables Migration
-- Date: 2026-10-07
-- Description: Creates isolated tables for Order Resolution module
-- Tables: order_resolutions, order_resolution_messages, order_resolution_audit_log
-- =======================================================================

SET NAMES utf8mb4;
SET foreign_key_checks = 0;

-- 1. Dedicated Order Resolutions Table
CREATE TABLE IF NOT EXISTS `order_resolutions` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `ticket_number` varchar(50) NOT NULL COMMENT 'Sequential or formatted resolution ticket ID',
  `order_id` int(11) NOT NULL COMMENT 'sales_order.order_id',
  `order_number` varchar(100) DEFAULT NULL COMMENT 'sales_order.increment_id',
  `product_id` int(11) DEFAULT NULL COMMENT 'products.id',
  `order_item_id` int(11) DEFAULT NULL COMMENT 'sales_order_items.item_id',
  `b2b_order_id` int(11) DEFAULT NULL COMMENT 'b2b_orders.order_id',
  `merchant_id` int(11) DEFAULT NULL COMMENT 'publisher.id',
  `customer_id` int(11) NOT NULL COMMENT 'customers.id',
  `category` enum('Delivery','Refund','Replacement','Others') NOT NULL DEFAULT 'Others',
  `priority` varchar(50) NOT NULL DEFAULT 'Medium',
  `status` enum('Open','Processing','Done','Close','ReOpen','Close (Final)') NOT NULL DEFAULT 'Open',
  `merchant_action` enum('none','refund_approved','refund_denied','replacement_approved','replacement_denied','replacement_completed') NOT NULL DEFAULT 'none',
  `delivery_option` enum('none','own_delivery','self_pickup','ym_delivery') NOT NULL DEFAULT 'none',
  `addon_purchase_id` int(11) DEFAULT NULL,
  `refund_amount` decimal(12,2) DEFAULT '0.00',
  `refund_deducted_from_holdback` tinyint(1) DEFAULT '0',
  `resolution_status` enum('none','resolution_requested','resolution_approved','resolution_denied') NOT NULL DEFAULT 'none',
  `resolution_requested_at` int(11) DEFAULT NULL,
  `assigned_role` enum('Help','Acct') DEFAULT 'Help',
  `assigned_to` int(11) DEFAULT NULL COMMENT 'adminusers.id',
  `subject` varchar(255) DEFAULT NULL,
  `message` text NOT NULL,
  `attachment` varchar(255) DEFAULT NULL,
  `is_active_dispute` tinyint(1) NOT NULL DEFAULT '1',
  `created_at` int(11) NOT NULL,
  `updated_at` int(11) NOT NULL,
  `closed_at` int(11) DEFAULT NULL,
  `closed_by` varchar(50) DEFAULT NULL,
  `ip` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `idx_ticket_number` (`ticket_number`),
  KEY `idx_order_id` (`order_id`),
  KEY `idx_customer_id` (`customer_id`),
  KEY `idx_merchant_id` (`merchant_id`),
  KEY `idx_status` (`status`),
  KEY `idx_assigned_role` (`assigned_role`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- 2. Dedicated Order Resolution Messages Table (Conversation)
CREATE TABLE IF NOT EXISTS `order_resolution_messages` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `resolution_id` int(11) NOT NULL,
  `ticket_number` varchar(50) NOT NULL,
  `sender_role` enum('shopper','merchant','help','acct') NOT NULL,
  `sender_id` int(11) NOT NULL,
  `sender_name` varchar(255) DEFAULT NULL,
  `message` text NOT NULL,
  `attachment` varchar(255) DEFAULT NULL,
  `created_at` int(11) NOT NULL,
  `ip` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_msg_res_id` (`resolution_id`),
  KEY `idx_msg_ticket_num` (`ticket_number`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- 3. Dedicated Order Resolution Audit Log
CREATE TABLE IF NOT EXISTS `order_resolution_audit_log` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `resolution_id` int(11) NOT NULL,
  `ticket_number` varchar(50) NOT NULL,
  `from_status` varchar(50) NOT NULL,
  `to_status` varchar(50) NOT NULL,
  `action` varchar(100) NOT NULL,
